# EIRVEN public configuration — copy to .env only when you need overrides.
EIRVEN_DATA_DIR=./data
EIRVEN_WORKSPACE_DIR=./workspace
EIRVEN_HOST=0.0.0.0
EIRVEN_PORT=7860

# Local models
EIRVEN_LLM_BACKEND=claude_code_local
# Официальный Claude Code CLI запускается локально и направляется на Ollama.
# Это не закрытая облачная модель Claude и не требует Anthropic API-ключа.
EIRVEN_CLAUDE_CODE_COMMAND=claude
EIRVEN_CLAUDE_CODE_FALLBACK=1
EIRVEN_CLAUDE_CODE_FAST_MODEL=eirven-claude:fast
EIRVEN_CLAUDE_CODE_MODEL=eirven-claude:main
# Установщик создаёт эти два alias поверх выбранных моделей; веса не дублируются.
EIRVEN_CLAUDE_CODE_CONTEXT=24576
EIRVEN_OLLAMA_URL=http://127.0.0.1:11434
EIRVEN_FAST_MODEL=qwen3.5:2b
EIRVEN_MODEL=gemma3:4b
EIRVEN_CODE_MODEL=qwen3.5:4b
EIRVEN_EMBEDDING_MODEL=qwen3-embedding:0.6b
EIRVEN_KEEP_ALIVE=30m

# Desktop and voice
EIRVEN_ENABLE_COMMANDS=true
EIRVEN_ENABLE_BROWSER=true
EIRVEN_ENABLE_DESKTOP_CONTROL=true
EIRVEN_FULL_ACCESS=true
EIRVEN_MAX_PARALLEL_TASKS=2
EIRVEN_ASR_ENGINE=gigaam
EIRVEN_GIGAAM_MODEL=gigaam-v3-e2e-ctc
EIRVEN_TTS_ENGINE=silero
EIRVEN_SILERO_MODEL=./models/silero/v5_5_ru.pt
EIRVEN_VOICE_SILENCE_MS=520
EIRVEN_COMPANION_ENABLED=true

# Updates. Public default is FoxInDev/EIRVEN-AI.
EIRVEN_UPDATE_REPO=FoxInDev/EIRVEN-AI
# Optional: do not commit a real token.
GITHUB_TOKEN=
