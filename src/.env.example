# EIRVEN public configuration — copy to .env only when you need overrides.
EIRVEN_LLM_FIRST_TOKEN_TIMEOUT=120
EIRVEN_LLM_INACTIVITY_TIMEOUT=45
EIRVEN_DATA_DIR=./data
EIRVEN_WORKSPACE_DIR=./workspace
EIRVEN_HOST=0.0.0.0
EIRVEN_PORT=7860

# Local models
# DeepSeek-Coder-V2 обслуживает текст, код, файлы и UI-планирование.
# Qwen3.5 Vision включается только для изображений и скриншотов.
EIRVEN_OLLAMA_URL=http://127.0.0.1:11434
EIRVEN_FAST_MODEL=deepseek-coder-v2:16b-lite-instruct-q4_k_m
EIRVEN_MODEL=deepseek-coder-v2:16b-lite-instruct-q4_k_m
EIRVEN_STRICT_RELEASE_MODEL=true
EIRVEN_RELEASE_MODEL=deepseek-coder-v2:16b-lite-instruct-q4_k_m
EIRVEN_CODE_MODEL=deepseek-coder-v2:16b-lite-instruct-q4_k_m
EIRVEN_DEEP_MODEL=deepseek-coder-v2:16b-lite-instruct-q4_k_m
EIRVEN_VISION_MODEL=qwen3.5:2b
EIRVEN_EMBEDDING_MODEL=
EIRVEN_KEEP_ALIVE=2h
EIRVEN_CHAT_NUM_CTX=4096
EIRVEN_TASK_NUM_CTX=8192
EIRVEN_SEMANTIC_MEMORY=false

# Desktop and voice
EIRVEN_ENABLE_COMMANDS=true
EIRVEN_ENABLE_BROWSER=true
EIRVEN_ENABLE_DESKTOP_CONTROL=true
EIRVEN_FULL_ACCESS=true
EIRVEN_MAX_PARALLEL_TASKS=2
EIRVEN_ASR_ENGINE=gigaam
EIRVEN_GIGAAM_MODEL=gigaam-v3-e2e-ctc
EIRVEN_TTS_ENGINE=silero
EIRVEN_SILERO_MODEL=./models/silero/v5_5_ru.pt
EIRVEN_VOICE_SILENCE_MS=520
EIRVEN_COMPANION_ENABLED=true

# Updates. Metadata and packages are requested from the official EIRVEN service.
# Do not put Express/VIP secrets in this file or in the APK; entitlement is server-side.
EIRVEN_UPDATE_API=https://eirven.foxyhosty.ru/api/eirven/v1
